# ==============================================================================
# KargoFlow Ghana - Environment Variables Specification
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV="development"

# App Public Hosting URL (used for Paystack webhook callbacks & CORS)
APP_BASE_URL="http://localhost:3000"

# Allowed CORS Origins (comma-separated for multi-domain deployments)
ALLOWED_ORIGINS="http://localhost:3000"

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kargoflow?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/kargoflow?retryWrites=true&w=majority"

# Express Session Encryption Secret (Generate a strong random 32+ character key)
SESSION_SECRET="kargoflow_super_secret_session_key_ghana_2026"

# Google Identity Services (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Admin Setup Bootstrap Token (Protects manual administrator provisioning endpoint)
ADMIN_SETUP_TOKEN="kargoflow_admin_init_token_2026"

# Paystack Ghana Integration (Secret and Public API Keys)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYMENT_CURRENCY="GHS"

# Resend Email Service Integration (Optional, for transactional dispatch notices)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="KargoFlow Ghana <support@kargoflow.gh>"

# Ghana Post GPS API Key (Optional, for automated digital address coordinate resolution)
VITE_GHANA_POST_GPS_API_KEY="YOUR_GHANA_POST_API_KEY"

# Frontend API Base URL (defaults to '/api' for same-origin serverless routing)
VITE_API_BASE_URL="/api"
